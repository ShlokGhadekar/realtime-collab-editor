# Copy to backend/.env for local development. Generate a secret with: openssl rand -hex 32
JWT_SECRET=

# Optional: https://www.jdoodle.com/compiler-api (code execution is disabled when unset)
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# Optional overrides (defaults shown)
# DATABASE_URL=jdbc:postgresql://localhost:5432/collabeditor
# DATABASE_USERNAME=collabuser
# DATABASE_PASSWORD=collabpass
# CORS_ALLOWED_ORIGINS=http://localhost:3000
